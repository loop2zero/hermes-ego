<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional Mac launchd agent. Forwards the VPS relay's localhost port over SSH.
  The relay stays on 127.0.0.1. install.sh fills __HOME__ and __SSH_TARGET__.
  The daemon then uses ws://127.0.0.1:8767/agent.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.ego.tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-N</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-L</string>
        <string>127.0.0.1:8767:127.0.0.1:8767</string>
        <string>__SSH_TARGET__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/hermes-ego/tunnel.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/hermes-ego/tunnel.err.log</string>
</dict>
</plist>
