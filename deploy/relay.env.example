# Copy to ~/.config/hermes-ego/relay.env and chmod 600.
# Used by deploy/hermes-ego-relay.service (EnvironmentFile).
EGO_RELAY_TOKEN=replace-with-a-long-random-string
EGO_RELAY_HOST=127.0.0.1
EGO_RELAY_PORT=8767
# ego_save_page_markdown writes only under this absolute directory.
# Leave it unset to disable that tool. The other tools keep working.
# EGO_SAVE_ROOT=/root/hermes-notes
# IANA timezone for the YYYY-MM-DD filename prefix and captured_at. Default UTC.
# EGO_SAVE_TZ=Europe/Berlin
# Optional. Created notes and asset files otherwise take the uid and gid of EGO_SAVE_ROOT.
# EGO_SAVE_UID=10000
# EGO_SAVE_GID=10000
# Synchronous images: relay (default, VPS, 90s budget), auto (Mac then VPS), or daemon.
# EGO_IMAGE_FETCH=relay
# Hard stop for the synchronous relay image phase, in milliseconds. Default 90000.
# EGO_IMAGE_BUDGET_MS=90000
